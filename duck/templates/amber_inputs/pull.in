# {title}
&cntrl
ntx={ntx}, irest={irest},{tempi}
iwrap=1,
ntb=1,
ntt=3, temp0={temp}, gamma_ln=4.0,
nstlim={iterations}, dt={time_step},
ntc=2, ntf=2, cut=9.0,
ntxo=1, ntpr=2000, ntwx={ntwx}, ntwe=0, ntwr=0, ioutfm=1,
jar=1, ig={seed},
ntr=1, restraintmask='(:{chunk_residues} & !@H=) {water_mask}', restraint_wt=1.0,
/
&wt type='DUMPFREQ', istep1={savefreq} /
&wt type='END'   /
DISANG={disang}
DUMPAVE={dumpave}
LISTIN=POUT
LISTOUT=POUT
