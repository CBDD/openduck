Bootstrap: docker
From: {{ BASE }}

# Build from the repository root; the build runs the unit tests (%test, ~10 min; skip them with --notest):
#     apptainer build openDUck.sif openDUck_singularity.def        (or singularity build)
#     apptainer exec --nv openDUck.sif openduck -h                 (--nv: OpenMM uses the GPU)
# Build arguments (--build-arg NAME=VALUE):
#     ENV_FILE  environment.yaml (newest tested versions, CUDA 12.9) or environment-py39.yaml (published
#               validation, CUDA 11.7). The GPU driver must support that CUDA version ("CUDA Version" in nvidia-smi).
#     BASE      base image, e.g. rockylinux/rockylinux:9

%arguments
    BASE=ubuntu:24.04
    ENV_FILE=environment.yaml

%files
    setup.py /opt/openduck/
    README.md /opt/openduck/
    LICENSE /opt/openduck/
    environment.yaml /opt/openduck/
    environment-py39.yaml /opt/openduck/
    duck /opt/openduck/
    scripts /opt/openduck/
    tests /opt/openduck/

%post
    set -eu
    if command -v apt-get > /dev/null; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install -y -qq --no-install-recommends wget ca-certificates bzip2 > /dev/null
        rm -rf /var/lib/apt/lists/*
    else
        dnf install -y -q wget bzip2 ca-certificates
        dnf clean all
    fi
    # Miniforge: conda-forge only
    wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh
    /opt/conda/bin/conda env create -q -n openduck -f /opt/openduck/{{ ENV_FILE }}
    /opt/conda/envs/openduck/bin/python -m pip install -q --no-deps /opt/openduck
    /opt/conda/bin/conda clean -a -y -q

%environment
    export PATH=/opt/conda/envs/openduck/bin:/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%test
    # the tests run on a copy, away from the sources, so they import the installed package
    work=$(mktemp -d)
    cp -r /opt/openduck/tests "$work/tests"
    cd "$work"
    python -m pytest -q -p no:cacheprovider tests

%runscript
    exec openduck "$@"

%labels
    AUTHOR Jochem Nelen (jnelen@ucam.edu)
    org.opencontainers.image.source https://github.com/CBDD/openduck
